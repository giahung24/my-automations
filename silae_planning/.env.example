# Silae Portal Credentials
SILAE_USERNAME=your_silae_username
SILAE_PASSWORD=your_silae_password
EMPLOYEE_ID=your_employee_id

# Google Calendar Configuration (service account)
# Path to the service account JSON key file...
GOOGLE_CREDENTIALS_FILE=credentials/google_credentials.json
# ...or paste the JSON content directly (takes precedence over the file)
# GOOGLE_CREDENTIALS_JSON={"type": "service_account", ...}
HOTEL_CALENDAR_ID=your_hotel_calendar_id

# Application Settings
TIMEZONE=Europe/Paris
LOG_LEVEL=INFO