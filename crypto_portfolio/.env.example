# Copy to .env  (git-ignored).  These override config.yaml.
# The Binance key needs "Enable Reading" ONLY - no trading, no withdrawals.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Optional overrides
# BINANCE_ENABLED=true
# EVM_WALLETS=0xabc...,0xdef...          # comma separated, all chains scanned
# SOLANA_WALLETS=So1...,So2...
# PORTFOLIO_DB=portfolio_history.db
# PORTFOLIO_CHARTS_DIR=./charts
# PORTFOLIO_MIN_VALUE=1.0

# Web dashboard (`python main.py serve`): required to bind anything but 127.0.0.1, and worth
# setting even behind Tailscale. Long and random, e.g.
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
# Type it on the app's unlock screen once per device.
# PORTFOLIO_WEB_TOKEN=
